{
  "name": "rustdesk-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RustDesk PWA client for Chromebook - remote desktop in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "proto": "pbjs -t static-module -w es6 --es6 --force-long --keep-case -o src/core/protocol/generated/proto.js -p ../libs/hbb_common/protos message.proto rendezvous.proto && pbts -o src/core/protocol/generated/proto.d.ts src/core/protocol/generated/proto.js"
  },
  "dependencies": {
    "fast-sha256": "^1.3.0",
    "libsodium-wrappers": "^0.7.15",
    "long": "^5.3.2",
    "pcm-player": "^0.0.11",
    "protobufjs": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "wasm-feature-detect": "^1.8.0",
    "zstddec": "^0.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "protobufjs-cli": "^2.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
